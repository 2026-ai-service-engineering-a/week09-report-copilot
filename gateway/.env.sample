# 게이트웨이(litellm-proxy)의 환경 변수. **운영자의 것**입니다.
#   cp gateway/.env.sample gateway/.env
#
# 앱(.env)과 갈라 둔 이유는 8주차 8장에 있습니다. 여기 두 값은 앱 컨테이너에
# 전달되지 않습니다. docker-compose.yml의 api 서비스 environment 목록을
# 보면 둘 다 없습니다.

# ── 진짜 프로바이더 키 ───────────────────────────────────────────
# 돈이 나가는 자리입니다. 하나만 채우면 됩니다.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── 게이트웨이의 관리자 키 ───────────────────────────────────────
# 어느 AI 회사에도 등록돼 있지 않은, 우리가 지어낸 값입니다.
# 이 키로만 가상키를 발급할 수 있고, :4000/ui/ 화면의 비밀번호이기도 합니다.
# 배포할 때는 반드시 긴 난수로 바꿉니다.
LITELLM_MASTER_KEY=sk-week09-master
