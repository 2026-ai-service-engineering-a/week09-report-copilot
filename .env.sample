# 앱(api)의 환경 변수.
#   cp .env.sample .env  후 .env 쪽을 채웁니다.
#
# **9주차에는 게이트웨이가 없습니다.** 8주차 8장에서 세운 판단 그대로입니다.
# 부르는 곳이 하나면 직접 호출이 맞고, 게이트웨이는 장애점을 하나 늘릴
# 뿐입니다. 게이트웨이가 값을 하는 것은 부르는 곳이 둘 이상이 되거나 키를
# 남에게 나눠줘야 할 때부터입니다.

# ── 앱의 실행 모드 ───────────────────────────────────────────────
# auto    키가 있으면 실제 호출, 없으면 각본 대역 (기본값)
# offline 키가 있어도 각본 대역만 쓴다 (수업·테스트용)
# live    반드시 실제 호출 (키가 없으면 502로 실패한다)
LLM_MODE=auto

# ── 프로바이더 키 ────────────────────────────────────────────────
# **하나만 채우면 됩니다.** 채워진 것을 찾아 기본 모델을 고릅니다.
#
#   GEMINI_API_KEY     → gemini/gemini-2.5-flash
#   OPENAI_API_KEY     → openai/gpt-4o-mini
#   ANTHROPIC_API_KEY  → anthropic/claude-haiku-4-5-20251001
#
# 이 키는 api 컨테이너에만 갑니다. 브라우저 번들에는 들어가지 않습니다.
# 화면은 우리 api만 부르고 모델은 서버가 부릅니다.

# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# 모델을 직접 고르고 싶을 때만. 비우면 위 표의 기본값을 씁니다.
# 리포트는 노드가 여럿이라 빠르고 싼 모델이 맞습니다.
# LLM_MODEL=gemini/gemini-2.5-flash

# 각본 대역의 지연(ms). 0으로 두면 스트리밍이 흐르는 것도, 요청이 도는
# 동안 화면이 어떻게 차오르는지도 눈에 보이지 않습니다.
# OFFLINE_LATENCY_MS=400
