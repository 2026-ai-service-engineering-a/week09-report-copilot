# 앱(api)의 환경 변수.
#   cp .env.sample .env  후 .env 쪽을 채웁니다.
#
# **이 파일에는 프로바이더 키가 없습니다.** 8주차와 같은 이유입니다. 이 랩의
# 앱은 모델을 직접 부르지 않고, 진짜 키와 마스터 키는 게이트웨이 쪽인
# `gateway/.env`에 있습니다 (`cp gateway/.env.sample gateway/.env`).

# ── 앱의 실행 모드 ───────────────────────────────────────────────
# auto    게이트웨이가 설정돼 있으면 실제 호출, 아니면 각본 대역 (기본값)
# offline 설정돼 있어도 각본 대역만 쓴다 (수업·테스트용)
# live    반드시 실제 호출 (게이트웨이가 없으면 502로 실패한다)
LLM_MODE=auto

# ── 앱이 게이트웨이를 거치게 하려면 ──────────────────────────────
# 절차는 8주차 8장 3절과 같습니다. 게이트웨이를 띄우고, 화면에서 가상키를
# 발급하고, 아래 둘을 채우고, 앱만 다시 만듭니다.
#
#   docker compose up -d --force-recreate api
#
# GATEWAY_URL=http://litellm-proxy:4000   compose 서비스 이름. localhost가 아니다
# GATEWAY_KEY=sk-…                        관리자 화면에서 발급받은 가상키

# 선택. 비우면 report다. gateway/config.yaml의 model_name 중 하나를 고른다.
#   report      진짜 모델 (게이트웨이가 쥔 프로바이더 키로 나간다)
#   report-demo 모의 응답 (모델을 부르지 않는다)
# GATEWAY_MODEL=report

# 각본 대역의 지연(ms). 0으로 두면 스트리밍이 흐르는 것도, 요청이 도는
# 동안 화면이 어떻게 차오르는지도 눈에 보이지 않는다
# OFFLINE_LATENCY_MS=400
